    {
      "id": "sulfur-vapour-pressure",
      "title": "Static sulfur vapour pressure",
      "domain": "thermodynamics",
      "tool": "runCapability",
      "apis": [
        "neqsim.thermo.util.sulfur.SulfurThermodynamics"
      ],
      "skills": [
        "neqsim-flow-assurance"
      ],
      "agents": [
        "flow-assurance"
      ],
      "testSources": [
        "src/test/java/neqsim/mcp/runners/GeneralCapabilityRunnerTest.java",
        "src/test/java/neqsim/thermo/util/sulfur/SulfurThermodynamicsTest.java",
        "neqsim-mcp-server/tests/protocol/test_capability_protocol.py"
      ],
      "limitations": "Search for calculateVapourPressureBar and invoke its exact double signature; this does not qualify other methods.",
      "operations": [
        {
          "id": "sulfur-vapour-pressure-at-temperature",
          "classification": "supported",
          "api": "neqsim.thermo.util.sulfur.SulfurThermodynamics",
          "method": "calculateVapourPressureBar",
          "signature": "double neqsim.thermo.util.sulfur.SulfurThermodynamics.calculateVapourPressureBar(double)",
          "units": {
            "inputs": {
              "temperature": "K"
            },
            "outputs": {
              "vapourPressure": "bar"
            }
          },
          "applicability": "Pure sulfur vapour pressure for 312.15 K through 1308.15 K; values outside the correlation range are rejected.",
          "route": "runCapability action=invoke",
          "example": {
            "arguments": [
              717.76
            ],
            "parameterTypes": [
              "double"
            ],
            "expected": 1.01325,
            "absoluteTolerance": 1e-10
          },
          "evidenceSources": [
            "src/test/java/neqsim/thermo/util/sulfur/SulfurThermodynamicsTest.java",
            "neqsim-mcp-server/tests/protocol/test_capability_protocol.py"
          ]
        }
      ]
    },
