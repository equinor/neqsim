              "bar",
              "barg",
              "psi",
              "psia",
              "psig",
              "Pa",
              "kPa",
              "MPa",
              "atm"
            ]
          },
          "applicability": "Absolute and gauge pressure conversions using the explicit source and target units; gauge conversions use NeqSim's fixed reference atmosphere.",
