{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neqsim.org/schemas/plant_layout_study.v1.json",
  "title": "NeqSim concept plant layout study",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "coordinate_system",
    "decks",
    "equipment"
  ],
  "properties": {
    "schema_version": {
      "const": "plant_layout_study.v1"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "facility_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "maturity": {
          "enum": [
            "SCREENING"
          ]
        },
        "facility_type": {
          "enum": [
            "onshore",
            "offshore_fixed",
            "offshore_floating"
          ]
        },
        "jurisdiction": {
          "type": "string"
        }
      }
    },
    "coordinate_system": {
      "type": "object",
      "required": [
        "length_unit",
        "mass_unit"
      ],
      "properties": {
        "length_unit": {
          "const": "m"
        },
        "mass_unit": {
          "const": "kg"
        },
        "origin": {
          "$ref": "#/$defs/point3"
        },
        "north_deg": {
          "type": "number"
        },
        "elevation_datum": {
          "type": "string"
        }
      }
    },
    "decks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "width_m",
          "depth_m",
          "elevation_m"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "width_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "depth_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "elevation_m": {
            "type": "number"
          },
          "height_limit_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "mass_limit_kg": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "equipment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tag",
          "size_m",
          "dimension_source",
          "allowed_decks"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "size_m": {
            "$ref": "#/$defs/size3"
          },
          "mass_kg": {
            "type": "number",
            "minimum": 0
          },
          "allowed_decks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "rotations_deg": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            }
          },
          "dimension_source": {
            "type": "object",
            "required": [
              "kind",
              "reference"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "synthetic_assumption",
                  "vendor",
                "calculated",
                "measured",
                "project_assumption"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "envelopes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "bounds_m"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "maintenance",
                    "operation",
                    "lifting"
                  ]
                },
                "bounds_m": {
                  "$ref": "#/$defs/box3"
                }
              }
            }
          },
          "fixed": {
            "$ref": "#/$defs/placement"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from_tag",
          "to_tag"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from_tag": {
            "type": "string"
          },
          "to_tag": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        }
      }
    },
    "physical_inventory_scope": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "source_reference",
        "required_connection_ids",
        "required_equipment_tags",
        "required_isolation_section_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "required_connection_ids": {
          "$ref": "#/$defs/uniqueIds"
        },
        "required_equipment_tags": {
          "$ref": "#/$defs/uniqueIds"
        },
        "required_isolation_section_ids": {
          "$ref": "#/$defs/uniqueIds"
        }
      }
    },
    "physical_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "connection_id",
          "line_tag",
          "internal_diameter_m",
          "centerline_m",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "connection_id": {
            "type": "string",
            "minLength": 1
          },
          "line_tag": {
            "type": "string",
            "minLength": 1
          },
          "internal_diameter_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "centerline_m": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/point3"
            }
          },
          "source": {
            "$ref": "#/$defs/physicalSource"
          }
        }
      }
    },
    "equipment_volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "equipment_tag",
          "volume_m3",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "equipment_tag": {
            "type": "string",
            "minLength": 1
          },
          "volume_m3": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "source": {
            "$ref": "#/$defs/physicalSource"
          }
        }
      }
    },
    "isolation_devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tag",
          "route_id",
          "chainage_m",
          "device_type",
          "normal_state",
          "fail_state",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "chainage_m": {
            "type": "number",
            "minimum": 0
          },
          "device_type": {
            "enum": [
              "blind",
              "check_valve",
              "emergency_shutdown_valve",
              "manual_valve",
              "other",
              "process_shutdown_valve"
            ]
          },
          "normal_state": {
            "$ref": "#/$defs/deviceState"
          },
          "fail_state": {
            "$ref": "#/$defs/deviceState"
          },
          "source": {
            "$ref": "#/$defs/physicalSource"
          }
        }
      }
    },
    "isolation_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "route_ids",
          "equipment_volume_ids",
          "boundary_device_ids",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "route_ids": {
            "$ref": "#/$defs/uniqueIds"
          },
          "equipment_volume_ids": {
            "$ref": "#/$defs/uniqueIds"
          },
          "boundary_device_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "$ref": "#/$defs/physicalSource"
          }
        }
      }
    },
    "corridors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "deck",
          "bounds_m",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "deck": {
            "type": "string"
          },
          "bounds_m": {
            "$ref": "#/$defs/box2"
          },
          "kind": {
            "enum": [
              "escape",
              "pipe_rack",
              "road"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "deck",
          "x_m",
          "y_m"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "deck": {
            "type": "string"
          },
          "x_m": {
            "type": "number"
          },
          "y_m": {
            "type": "number"
          }
        }
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "deck",
          "bounds_m"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "deck": {
            "type": "string"
          },
          "bounds_m": {
            "$ref": "#/$defs/box3"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "minimum_separation",
              "required_evidence"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "minimum_m": {
            "type": "number",
            "minimum": 0
          },
          "from_tag": {
            "type": "string"
          },
          "to_tag": {
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_status": {
            "type": "string"
          }
        }
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document",
          "edition",
          "access_status",
          "reference"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "alternatives": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "grid_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "backend": {
          "enum": [
            "deterministic",
            "auto",
            "ortools"
          ]
        }
      }
    }
  },
  "$defs": {
    "uniqueIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deviceState": {
      "enum": [
        "OPEN",
        "CLOSED",
        "VARIABLE",
        "AS_IS",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "physicalSource": {
      "type": "object",
      "required": [
        "kind",
        "reference",
        "revision",
        "evidence_status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "as_built",
            "layout_model",
            "line_list",
            "piping_model",
            "project_assumption",
            "survey",
            "synthetic_assumption",
            "vendor_document"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "enum": [
            "CONTROLLED_PROJECT_INPUT",
            "REVIEW_REQUIRED",
            "ASSUMPTION"
          ]
        }
      }
    },
    "point3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "size3": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 3,
      "maxItems": 3
    },
    "box2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "box3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "reference",
        "access_status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "project_requirement",
            "standard",
            "software_model"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "access_status": {
          "enum": [
            "verified_full_text",
            "metadata_only",
            "unavailable"
          ]
        },
        "document": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "clause": {
          "type": "string"
        }
      }
    },
    "placement": {
      "type": "object",
      "required": [
        "deck",
        "x_m",
        "y_m",
        "rotation_deg"
      ],
      "properties": {
        "deck": {
          "type": "string"
        },
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "rotation_deg": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        }
      }
    }
  },
  "$comment": "Runtime normalization also rejects nonfinite values, duplicate identities, inverted boxes, unresolved tag/deck references and unsupported geometry. Schema metadata is not proof of standard compliance."
}
